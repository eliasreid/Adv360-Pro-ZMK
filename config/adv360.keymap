#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        lhm: left_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "LEFT_HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <7 8 9 10 11 12 13 24 25 26 27 42 43 44 45 56 57 58 59 72 73 74 75 21 22 23 38 39 40 41 54 55 71 37 38 53 68 69 70>;
            require-prior-idle-ms = <125>;
        };

        l_momentary_tap: l_momentary_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "L_MOMENTARY_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75>;
            require-prior-idle-ms = <125>;
        };

        rhm: right_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "RIGHT_HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
            require-prior-idle-ms = <125>;
        };

        r_momentary_tap: r_momentary_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "R_MOMENTARY_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;

            require-prior-idle-ms = <125>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        mom_tap: mom_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOM_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;

            require-prior-idle-ms = <125>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1        &kp N2                &kp N3            &kp N4             &kp N5  &tog 1                                                                        &mo 5      &kp N6  &kp N7              &kp N8            &kp N9                     &kp N0                       &kp MINUS
&kp TAB    &kp Q         &kp W                 &kp E             &kp R              &kp T   &kp TAB                                                                       &none      &kp Y   &kp U               &kp I             &kp O                      &kp P                        &kp BSLH
&kp ESC    &lhm LCTRL A  &lhm LEFT_ALT S       &lhm LEFT_META D  &lhm LEFT_SHIFT F  &kp G   &none     &kp LCTRL       &kp LALT          &kp RIGHT_ALT  &kp RCTRL          &none      &kp H   &rhm RIGHT_SHIFT J  &rhm RIGHT_GUI K  &rhm RIGHT_ALT L           &rhm RCTRL RC(LEFT_BRACKET)  &kp SQT
&kp LSHFT  &kp Z         &l_momentary_tap 2 X  &kp C             &kp V              &kp B                             &kp LEFT_GUI      &kp RIGHT_GUI                                &kp N   &kp M               &kp COMMA         &r_momentary_tap 2 PERIOD  &kp FSLH                     &kp RSHFT
&mo 4      &kp GRAVE     &kp CAPS              &kp LEFT          &kp LSHIFT                 &kp BSPC  &mom_tap 1 TAB  &kp DEL           &none          &mom_tap 1 RETURN  &kp SPACE          &kp RSHIFT          &kp DOWN          &kp LBKT                   &kp RBKT                     &mo 4
            >;
        };

        navigation {
            bindings = <
&trans  &trans     &trans        &trans    &trans     &trans  &trans                                                     &trans  &trans    &trans         &trans        &trans     &trans   &trans
&trans  &trans     &trans        &trans    &trans     &trans  &kp Y                                                      &trans  &trans    &trans         &trans        &trans     &trans   &trans
&trans  &kp A      &kp S         &kp D     &kp F      &trans  &kp H         &trans     &kp NUMBER_8      &trans  &trans  &trans  &kp LEFT  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &kp END  &trans
&trans  &trans     &kp X         &trans    &trans     &trans                           &kp N9            &trans                  &kp F4    &kp PAGE_DOWN  &kp PAGE_UP   &trans     &trans   &trans
&trans  &kp GRAVE  &kp LEFT_ALT  &kp LEFT  &kp RIGHT          &kp NUMBER_6  &kp SPACE  &kp NUMBER_0      &trans  &trans  &trans            &trans         &trans        &trans     &trans   &trans
            >;

            label = "nav";
        };

        symbols {
            bindings = <
&trans  &trans         &trans         &trans         &trans        &trans        &trans                                      &trans  &trans         &trans        &trans        &trans         &trans       &trans
&trans  &kp GRAVE      &kp LS(TILDE)  &kp LS(POUND)  &kp LS(AMPS)  &kp LS(PIPE)  &trans                                      &trans  &kp LS(CARET)  &kp LS(LBRC)  &kp LS(RBRC)  &kp LBKT       &kp RBKT     &trans
&trans  &kp LS(EXCL)   &kp LS(UNDER)  &kp LS(COLON)  &kp EQUAL     &kp LS(DLLR)  &trans  &trans  &trans      &trans  &trans  &trans  &kp LS(AT)     &kp LS(LPAR)  &kp LS(RPAR)  &kp LS(UNDER)  &kp SEMI     &trans
&trans  &kp LS(PRCNT)  &kp LS(QMARK)  &kp LS(STAR)   &kp LS(PLUS)  &kp BSLH                      &trans      &trans                  &kp FSLH       &kp MINUS     &kp LS(LT)    &kp LS(GT)     &kp LS(DQT)  &trans
&trans  &trans         &trans         &trans         &trans                      &trans  &trans  &trans      &trans  &trans  &trans                 &trans        &trans        &trans         &trans       &trans
            >;

            label = "sym";
        };

        keypad {
            display-name = "kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 5      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 4      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 4
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2     &kp F3         &kp F4  &kp F5  &kp F6  &tog 3                                      &mo 5   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans     &trans         &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans     &trans         &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans     &trans         &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &kp LG(M)  &kp LG(LA(M))  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
